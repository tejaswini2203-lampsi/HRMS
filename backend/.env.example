# EICS backend environment (copy values as needed; do not commit secrets)

# JWT
JWT_SECRET=eics-dev-jwt-secret-change-me
JWT_EXPIRES_IN=8h

# Optional seed password used by scripts/apply-uat-schema.js
# Also used as the initial password for AppUser accounts created with new employees.
# EICS_DEFAULT_PASSWORD=eics@4321

# Email (optional — if unset, passport alerts are logged and Status=Failed with reason)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@eics.local
MAIL_SECURE=false
